# Backend environment configuration for SemanticEngine
# Copy this file to .env and update values before running the backend.
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
GEMINI_API_KEY=your_google_generative_ai_api_key

# NOTE: GEMINI_API_KEY should be a valid Google Cloud API key for the Generative Language API.
# Example API key prefixes usually start with "AIzaSy" for Google API keys.
# If you use service account credentials instead, you must update the backend auth logic accordingly.
